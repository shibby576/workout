# Set these in Vercel: Project Settings → Environment Variables.
# Never commit real values — this file is placeholders only.

# Client ID from https://www.strava.com/settings/api — not secret, but
# also needed server-side for the token exchange, so it's set twice:
# once with the VITE_ prefix (bundled into the frontend) and once without
# (read by the /api serverless functions). Same value both times.
VITE_STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_ID=your_strava_client_id

# Client Secret from the same Strava settings page — never expose this
# with a VITE_ prefix, it would ship inside the browser bundle.
STRAVA_CLIENT_SECRET=your_strava_client_secret
